using Workerd = import "/workerd/workerd.capnp";
const config :Workerd.Config = (
  services = [
    (name = "realtime", worker = .realtimeWorker),
    (name = "do-disk", disk = (writable = true)),
    (name = "internet", network = (
      allow = ["public"@PRIVATE_ADDRESSES@],
      tlsOptions = (trustBrowserCas = true),
    )),
  ],
  sockets = [(name = "http", address = "*:8787", http = (), service = "realtime")],
);
const realtimeWorker :Workerd.Worker = (
  compatibilityDate = "2026-07-01",
  compatibilityFlags = ["nodejs_als"],
  modules = [
    (name = "entry.js", esModule = embed "realtime-entry.js"),
    (name = "s3-bucket.js", esModule = embed "s3-bucket.js"),
    (name = "index.js", esModule = embed "index.js"),
  ],
  durableObjectNamespaces = [
    (className = "OrgHub", uniqueKey = "superset_realtime_org_v1", enableSql = true),
    (className = "PageHub", uniqueKey = "superset_realtime_page_v1", enableSql = true),
  ],
  durableObjectStorage = (localDisk = "do-disk"),
  bindings = [
    (name = "NEXT_PUBLIC_API_URL", fromEnvironment = "NEXT_PUBLIC_API_URL"),
    (name = "USERCONTENT_URL", fromEnvironment = "USERCONTENT_URL"),
    (name = "NUDGE_SECRET", fromEnvironment = "NUDGE_SECRET"),
    (name = "OrgHub", durableObjectNamespace = "OrgHub"),
    (name = "PageHub", durableObjectNamespace = "PageHub"),
    (name = "S3_ENDPOINT", fromEnvironment = "S3_ENDPOINT"),
    (name = "S3_BUCKET", fromEnvironment = "S3_BUCKET"),
    (name = "S3_ACCESS_KEY", fromEnvironment = "S3_ACCESS_KEY"),
    (name = "S3_SECRET_KEY", fromEnvironment = "S3_SECRET_KEY"),
    @OPTIONAL_BINDINGS@
  ],
  globalOutbound = "internet",
);
