{
	"name": "@superset/repo",
	"version": "0.0.0",
	"repository": {
		"type": "git"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.2",
		"@blaxel/core": "0.3.19",
		"@types/bun": "1.3.14",
		"@types/semver": "7.7.1",
		"dotenv-cli": "11.0.0",
		"semver": "7.7.4",
		"sherif": "1.11.0",
		"turbo": "2.10.9",
		"typescript": "6.0.3"
	},
	"description": "Superset Monorepo",
	"homepage": "https://superset.sh",
	"license": "Elastic-2.0",
	"packageManager": "bun@1.3.14",
	"private": true,
	"scripts": {
		"predev": "bun scripts/check-dev-ports.ts",
		"dev": "turbo run dev --filter=@superset/api --filter=@superset/web --filter=@superset/desktop --filter=//",
		"dev:all": "turbo dev --concurrency=15",
		"predev:desktop": "bun scripts/check-dev-ports.ts",
		"dev:desktop": "turbo run dev --filter=@superset/api --filter=@superset/desktop --filter=//",
		"dev:docs": "turbo dev --filter=@superset/docs",
		"dev:marketing": "turbo dev --filter=@superset/marketing --filter=@superset/docs",
		"dev:relay": "turbo dev --filter=@superset/relay",
		"cli:dev": "bun scripts/dev-cli.ts",
		"dev:skills": "bun scripts/sync-dev-skills.ts",
		"build": "turbo build --filter=@superset/desktop",
		"test": "turbo test --concurrency=2",
		"lint": "./scripts/lint.sh",
		"lint:fix": "bunx @biomejs/biome@2.4.2 migrate --write && bunx @biomejs/biome@2.4.2 check --write --unsafe .",
		"format": "bunx @biomejs/biome@2.4.2 format --write .",
		"format:check": "bunx @biomejs/biome@2.4.2 format .",
		"typecheck": "turbo typecheck",
		"ui-add": "turbo run ui-add",
		"postinstall": "./scripts/postinstall.sh",
		"clean": "git clean -xdf node_modules",
		"clean:workspaces": "turbo clean",
		"release": "bun scripts/release/release.ts",
		"release:desktop": "bun scripts/release/desktop.ts",
		"release:cli": "bun scripts/release/cli.ts",
		"release:canary": "./scripts/release-canary.sh",
		"check:versions": "bun scripts/release/check-versions.ts",
		"check:plugins": "bun scripts/check-plugins.ts",
		"check:i18n": "bun run --cwd packages/i18n check",
		"typecheck:release": "tsc -p scripts/release/tsconfig.json",
		"test:release": "bun test scripts/release",
		"db:push": "bun run --cwd packages/db push",
		"db:migrate": "bun run --cwd packages/db migrate",
		"db:seed-dev": "NODE_ENV=development bun run packages/auth/src/seed-dev.ts",
		"db:generate:desktop": "bun run --cwd packages/local-db generate",
		"db:seed-shared-environments": "bun run scripts/sandbox/seed-environments.ts",
		"sandbox:smoke": "bun packages/trpc/scripts/sandbox-smoke.ts",
		"sandbox:release": "bun scripts/sandbox/release-environments.ts"
	},
	"type": "module",
	"workspaces": [
		"packages/*",
		"apps/*",
		"tooling/*"
	],
	"overrides": {
		"@tiptap/extension-dropcursor": "3.30.4",
		"@tiptap/extension-floating-menu": "3.30.4",
		"@tiptap/extension-gapcursor": "3.30.4",
		"@tiptap/extension-list": "3.30.4",
		"@tiptap/extension-list-keymap": "3.30.4",
		"@tiptap/extensions": "3.30.4",
		"@types/hast": "3.0.5",
		"axios": "1.18.1",
		"hono": "4.12.34",
		"kysely": "0.28.17",
		"rollup": "4.62.3",
		"shell-quote": "1.9.0"
	},
	"trustedDependencies": [
		"better-sqlite3",
		"bufferutil",
		"electron",
		"esbuild",
		"koffi",
		"node-pty",
		"sharp",
		"utf-8-validate",
		"workerd"
	],
	"patchedDependencies": {
		"@xterm/addon-webgl@0.20.0-beta.297": "patches/@xterm%2Faddon-webgl@0.20.0-beta.297.patch",
		"metro@0.84.4": "patches/metro@0.84.4.patch",
		"node-pty@1.2.0-beta.14": "patches/node-pty@1.2.0-beta.14.patch"
	}
}
