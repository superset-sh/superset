{
	"name": "@superset/trpc",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./integrations/*": {
			"types": "./src/lib/integrations/*/index.ts",
			"default": "./src/lib/integrations/*/index.ts"
		},
		"./cloud-workspace-provision": {
			"types": "./src/router/cloud-workspace/provision.ts",
			"default": "./src/router/cloud-workspace/provision.ts"
		},
		"./automation-dispatch": {
			"types": "./src/router/automation/dispatch.ts",
			"default": "./src/router/automation/dispatch.ts"
		},
		"./automation-webhook-secret": {
			"types": "./src/router/automation/webhookSecret.ts",
			"default": "./src/router/automation/webhookSecret.ts"
		},
		"./insight-registry": {
			"types": "./src/router/analytics/insight-registry.ts",
			"default": "./src/router/analytics/insight-registry.ts"
		},
		"./business-metrics": {
			"types": "./src/router/analytics/business.ts",
			"default": "./src/router/analytics/business.ts"
		}
	},
	"scripts": {
		"clean": "git clean -xdf .cache .turbo dist node_modules",
		"typecheck": "tsc --noEmit --emitDeclarationOnly false"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "0.78.0",
		"@azure/msal-node": "5.5.0",
		"@blaxel/core": "0.3.11",
		"@googleapis/calendar": "16.0.0",
		"@googleapis/gmail": "18.0.0",
		"@linear/sdk": "68.1.1",
		"@microsoft/microsoft-graph-client": "3.0.7",
		"@notionhq/client": "5.25.2",
		"@octokit/app": "16.1.2",
		"@slack/web-api": "7.15.0",
		"@superset/auth": "workspace:*",
		"@superset/db": "workspace:*",
		"@superset/email": "workspace:*",
		"@superset/shared": "workspace:*",
		"@t3-oss/env-core": "0.13.11",
		"@trpc/server": "11.16.0",
		"@upstash/qstash": "2.10.1",
		"@upstash/ratelimit": "2.0.8",
		"@upstash/redis": "1.37.0",
		"@vercel/blob": "2.3.2",
		"@vercel/kv": "3.0.0",
		"drizzle-orm": "0.45.2",
		"gaxios": "7.3.1",
		"google-auth-library": "10.5.0",
		"posthog-node": "5.28.8",
		"resend": "6.18.0",
		"superjson": "2.2.6",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@microsoft/microsoft-graph-types": "2.43.1",
		"@superset/typescript": "workspace:*",
		"@types/node": "24.12.0",
		"typescript": "6.0.3"
	}
}
