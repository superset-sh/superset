msgid "The run was skipped because <0>{0}</0> isn't connected to the Superset relay. Make sure relay access is on in Settings > Remote Access on that device, then run it again."
msgstr "Lần chạy bị bỏ qua vì <0>{0}</0> chưa kết nối tới relay của Superset. Hãy đảm bảo đã bật truy cập relay trong Cài đặt > Truy cập từ xa trên thiết bị đó, rồi chạy lại."

msgid "The run was skipped because this device isn't connected to the Superset relay. Automations go through the relay even when they run on this device. Enable relay access, then run it again."
msgstr "Lần chạy bị bỏ qua vì thiết bị này chưa kết nối tới relay của Superset. Tự động hóa luôn đi qua relay kể cả khi chạy trên chính thiết bị này. Hãy bật truy cập relay rồi chạy lại."

msgid "The scorecard"
msgstr "Bảng điểm"

msgid "The self-driving software factory"
msgstr "Nhà máy phần mềm tự vận hành"

