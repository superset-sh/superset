msgid "marketing.faq.platforms.question"
msgstr "Superset chạy trên những nền tảng nào?"

#. js-lingui-explicit-id
msgid "marketing.faq.supportedAgents.answer"
msgstr "Superset làm việc với mọi coding agent dạng CLI, gồm Claude Code, OpenCode, OpenAI Codex và nhiều agent khác. Chọn agent khác nhau cho từng tác vụ mà không phải đổi workspace hay quy trình review."

