msgid "You'd be <0>#{0}</0> of {1}."
msgstr "Saresti <0>#{0}</0> su {1}."

msgid "You'd be one of the first on the board."
msgstr "Saresti tra i primi in classifica."

msgid "You'll need to sign in again to use Superset on this device."
msgstr "Dovrai accedere di nuovo per usare Superset su questo dispositivo."

msgid "You'll stop being a member of this team. You can be re-added by another team member."
msgstr "Smetterai di essere membro di questo team. Un altro membro del team può riaggiungerti."

msgid "You're about to change your role from {currentRoleName} to {newRoleName}. Another owner will need to restore your permissions. Are you sure?"
msgstr "Stai per cambiare il tuo ruolo da {currentRoleName} a {newRoleName}. Un altro proprietario dovrà ripristinare i tuoi permessi. Sei sicuro?"

msgid "You're about to get Superset"
msgstr "Stai per ottenere Superset"

msgid "You're all set!"
msgstr "È tutto pronto!"

msgid "You're on the leaderboard, but not ranked yet"
msgstr "Sei in classifica, ma non ancora posizionato"

msgid "You're on the list!"
msgstr "Sei in lista!"

msgid "You're one of our most active users. Come help us build it."
msgstr "Sei uno dei nostri utenti più attivi. Vieni a costruirlo con noi."

msgid "You're up to date!"
msgstr "Sei aggiornato!"

msgid "You've been invited to join {organization}"
msgstr "Sei stato invitato a entrare in {organization}"

msgid "Your account is deactivated and will be permanently deleted soon. Reactivate to restore it exactly as you left it."
msgstr "Il tuo account è disattivato e sarà eliminato definitivamente a breve. Riattivalo per ripristinarlo esattamente come l'hai lasciato."

msgid "Your account is managed by your organization. Contact your admin to create a new organization."
msgstr "Il tuo account è gestito dalla tua organizzazione. Contatta l'amministratore per creare una nuova organizzazione."

msgid "Your Agents, Your Accounts"
msgstr "I tuoi agenti, i tuoi account"

msgid "Your browser doesn't report which chip you have, so this is the Apple Silicon build. On an Intel Mac, <0>get the Intel build</0> instead."
msgstr "Il tuo browser non indica quale chip hai, quindi questa è la build per Apple Silicon. Su un Mac con Intel, <0>scarica invece la build Intel</0>."

msgid "Your changes will be lost if you don't save them."
msgstr "Le tue modifiche andranno perse se non le salvi."

msgid "Your code stays local by default, with explicit control over connected services."
msgstr "Il tuo codice resta locale per impostazione predefinita, con controllo esplicito sui servizi collegati."

msgid "Your download starts automatically. If it didn't, grab it here."
msgstr "Il download parte automaticamente. Se non è partito, scaricalo qui."

msgid "Your name"
msgstr "Il tuo nome"

msgid "Your name <0>(if we use your prompt, we'll credit you in the changelog)</0>"
msgstr "Il tuo nome <0>(se usiamo il tuo prompt, ti citeremo nel changelog)</0>"

