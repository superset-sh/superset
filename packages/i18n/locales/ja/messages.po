msgid "You appear to be offline"
msgstr "オフラインのようです"

msgid "You are not a member of this organization"
msgstr "この組織のメンバーではありません"

msgid "You are not authorized to perform this action."
msgstr "この操作を行う権限がありません。"

msgid "You are on the <0>{currentPlanLabel} plan</0>. If you have any questions or would like further support with your plan, <1>contact us<2/></1>."
msgstr "現在<0>{currentPlanLabel}プラン</0>をご利用中です。プランについてご質問やサポートが必要な場合は、<1>お問い合わせ<2/></1>ください。"

msgid "You are the only owner of an organization that has other members. Transfer ownership or delete the organization first."
msgstr "他にメンバーがいる組織の唯一のオーナーです。先にオーナー権限を移譲するか、組織を削除してください。"

msgid "You can't undo this action. Terminal panes will show \"Process exited\" and can be restarted."
msgstr "この操作は元に戻せません。ターミナルペインに「Process exited」と表示され、再起動できます。"

msgid "You don't have access to this host"
msgstr "このホストへのアクセス権がありません"

msgid "You don't have access to this host. If it's your own device, turn on relay access there under Settings > Security."
msgstr "このホストへのアクセス権がありません。自分のデバイスであれば、そのデバイスの設定 > セキュリティでリレーアクセスを有効にしてください。"

msgid "You don't have access to this terminal."
msgstr "このターミナルへのアクセス権がありません。"

msgid "You don't have permission to remove this member"
msgstr "このメンバーを削除する権限がありません"

msgid "You need to be part of an organization to use integrations."
msgstr "連携を使うには組織に所属している必要があります。"

#. placeholder {0}: preview.rank
#. placeholder {1}: preview.total
msgid "You'd be <0>#{0}</0> of {1}."
msgstr "{1}人中<0>#{0}</0>になります。"

msgid "You'd be one of the first on the board."
msgstr "ボードの最初のメンバーの一人になれます。"

msgid "You'll need to sign in again to use Superset on this device."
msgstr "このデバイスでSupersetを使うには、再度サインインが必要になります。"

msgid "You'll stop being a member of this team. You can be re-added by another team member."
msgstr "このチームのメンバーでなくなります。他のチームメンバーが再追加できます。"

msgid "You're about to change your role from {currentRoleName} to {newRoleName}. Another owner will need to restore your permissions. Are you sure?"
msgstr "自分のロールを{currentRoleName}から{newRoleName}に変更しようとしています。権限を戻すには別のオーナーが必要です。よろしいですか?"

msgid "You're about to get Superset"
msgstr "まもなくSupersetを入手できます"

msgid "You're all set!"
msgstr "準備完了です!"

msgid "You're on the leaderboard, but not ranked yet"
msgstr "リーダーボードに参加済みですが、まだランク付けされていません"

msgid "You're on the list!"
msgstr "登録が完了しました!"

msgid "You're one of our most active users. Come help us build it."
msgstr "最もアクティブなユーザーのお一人です。一緒に作りませんか。"

msgid "You're up to date!"
msgstr "最新の状態です!"

msgid "You've been invited to join {organization}"
msgstr "{organization}への招待が届いています"

msgid "Your account is deactivated and will be permanently deleted soon. Reactivate to restore it exactly as you left it."
msgstr "アカウントは無効化されており、まもなく完全に削除されます。再有効化すると元の状態に戻ります。"

msgid "Your account is managed by your organization. Contact your admin to create a new organization."
msgstr "アカウントは組織によって管理されています。新しい組織を作成するには管理者に連絡してください。"

msgid "Your Agents, Your Accounts"
msgstr "エージェントもアカウントも、あなたのもの"

msgid "Your browser doesn't report which chip you have, so this is the Apple Silicon build. On an Intel Mac, <0>get the Intel build</0> instead."
msgstr "お使いのブラウザはチップの種類を報告しないため、これはApple Silicon版です。IntelのMacをお使いの場合は、代わりに<0>Intel版を入手</0>してください。"

msgid "Your changes will be lost if you don't save them."
msgstr "保存しないと変更は失われます。"

msgid "Your code stays local by default, with explicit control over connected services."
msgstr "コードは既定でローカルに留まり、連携するサービスは明示的に制御できます。"

msgid "Your download starts automatically. If it didn't, grab it here."
msgstr "ダウンロードは自動的に開始されます。開始されない場合はこちらから取得してください。"

msgid "Your name"
msgstr "あなたの名前"

msgid "Your name <0>(if we use your prompt, we'll credit you in the changelog)</0>"
msgstr "お名前 <0>(プロンプトを採用した場合、changelogでクレジットします)</0>"

#. placeholder {0}: COMPANY.DOMAIN
msgid "Your organization's plan is managed by its owner at {0}."
msgstr "組織のプランは{0}でオーナーが管理しています。"

msgid "Your rank"
msgstr "あなたのランク"

msgid "Your Slack account has been linked to Superset. You can close this tab and return to Slack."
msgstr "SlackアカウントをSupersetに紐付けました。このタブを閉じてSlackに戻れます。"

msgid "Your subscription has been activated. You can now access all Pro features."
msgstr "サブスクリプションが有効になりました。すべてのPro機能を利用できます。"

msgid "Your subscription will be adjusted accordingly."
msgstr "サブスクリプションはそれに応じて調整されます。"

msgid "Your Superset download is starting."
msgstr "Supersetのダウンロードを開始しています。"

msgid "Your terminal sessions won't be interrupted."
msgstr "ターミナルセッションは中断されません。"

msgid "Your tokens"
msgstr "あなたのトークン"

msgid "Your version: {currentVersion}"
msgstr "現在のバージョン: {currentVersion}"

msgid "Zap"
msgstr "稲妻"

msgid "Zero-edit majority on merged agent PRs"
msgstr "マージされたエージェントのPRの過半数が編集ゼロ"

msgid "Zoom"
msgstr "ズーム"

msgid "Zoom in"
msgstr "拡大"

msgid "Zoom In"
msgstr "拡大"

msgid "Zoom out"
msgstr "縮小"

msgid "Zoom Out"
msgstr "縮小"

