msgid "marketing.factory.scorecard.f3Parallel.gate"
msgstr "3+ concurrent workstreams per engineer"

#. js-lingui-explicit-id
msgid "marketing.factory.scorecard.f3Parallel.note"
msgstr "Daily practice for our team and our heaviest users."

#. js-lingui-explicit-id
msgid "marketing.factory.scorecard.f3Routine.gate"
msgstr "Routine tickets with no mid-task intervention"

#. js-lingui-explicit-id
msgid "marketing.factory.scorecard.f3Routine.note"
msgstr "Standard for well-scoped work in isolated workspaces."

#. js-lingui-explicit-id
msgid "marketing.factory.scorecard.f3ZeroEdit.gate"
msgstr "Zero-edit majority on merged agent PRs"

#. js-lingui-explicit-id
msgid "marketing.factory.scorecard.f3ZeroEdit.note"
msgstr "True for routine work, not yet for gnarly refactors."

#. js-lingui-explicit-id
msgid "marketing.factory.scorecard.f4Latency.gate"
msgstr "Ticket to production under one day, median"

#. js-lingui-explicit-id
msgid "marketing.factory.scorecard.f4Latency.note"
msgstr "Review and CI queues eat the gains agents create."

#. js-lingui-explicit-id
msgid "marketing.factory.scorecard.f4Majority.gate"
msgstr "Half of merged changes are zero-edit agent code"

#. js-lingui-explicit-id
msgid "marketing.factory.scorecard.f4Majority.note"
msgstr "Humans still edit or heavily steer most merged diffs."

#. js-lingui-explicit-id
msgid "marketing.factory.scorecard.f4Overnight.gate"
msgstr "Unattended overnight runs, mergeable by morning"

#. js-lingui-explicit-id
msgid "marketing.factory.scorecard.f4Overnight.note"
msgstr "Works when environments are clean. Environments are rarely clean."

#. js-lingui-explicit-id
msgid "marketing.factory.scorecard.f4Parallel.gate"
msgstr "10+ concurrent workstreams without dropped state"

#. js-lingui-explicit-id
msgid "marketing.factory.scorecard.f4Parallel.note"
msgstr "Possible on good days. Supervision cost still grows too fast."

#. js-lingui-explicit-id
msgid "marketing.factory.scorecard.f4Review.gate"
msgstr "Agent review at parity with human review"

#. js-lingui-explicit-id
msgid "marketing.factory.scorecard.f4Review.note"
msgstr "Agent review catches real bugs but is not yet trusted alone."

#. js-lingui-explicit-id
msgid "marketing.factory.scorecard.intro"
msgstr "Our read as of August 2026, based on our own team and the teams we watch closely. F3 is mostly open. F4 is mostly closed. That gap is the work."

