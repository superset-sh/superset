From c769cc26289153c4d168c4d65ee9a539de9d3d6a Mon Sep 17 00:00:00 2001
From: Kiet Ho <hoakiet98@gmail.com>
Date: Sat, 10 Oct 2026 17:28:31 -0700
Subject: [PATCH] chore(desktop,mobile): route bundle and menu display names
 through one value

productName keeps naming the bundle, userData, logs and keychain entry;
CFBundleName/CFBundleDisplayName, the Linux desktop entry, the macOS app
menu, About panel and notification registration now read a display name.
---
 apps/desktop/electron-builder.canary.ts       |  9 +++++++--
 apps/desktop/electron-builder.ts              |  8 ++++++--
 apps/desktop/src/main/index.ts                |  4 +++-
 apps/desktop/src/main/lib/app-display-name.ts | 12 ++++++++++++
 apps/desktop/src/main/lib/menu.ts             | 12 +++++++-----
 apps/mobile/app.config.ts                     |  2 ++
 6 files changed, 37 insertions(+), 10 deletions(-)
 create mode 100644 apps/desktop/src/main/lib/app-display-name.ts

diff --git a/apps/desktop/electron-builder.canary.ts b/apps/desktop/electron-builder.canary.ts
index 8cdac856a7..12b836385f 100644
--- a/apps/desktop/electron-builder.canary.ts
+++ b/apps/desktop/electron-builder.canary.ts
@@ -14,6 +14,7 @@ import baseConfig from "./electron-builder";
 import pkg from "./package.json";
 
 const productName = "Superset Canary";
+const displayName = "Superset Canary";
 const canaryMacIconPath = join(pkg.resources, "build/icons/icon-canary.icns");
 const canaryLinuxIconPath = join(pkg.resources, "build/icons/icon-canary.png");
 const canaryWinIconPath = join(pkg.resources, "build/icons/icon-canary.ico");
@@ -36,8 +37,8 @@ const config: Configuration = {
 		artifactName: `Superset-Canary-\${version}-\${arch}.\${ext}`,
 		extendInfo: {
 			...baseConfig.mac?.extendInfo,
-			CFBundleName: productName,
-			CFBundleDisplayName: productName,
+			CFBundleName: displayName,
+			CFBundleDisplayName: displayName,
 		},
 	},
 
@@ -45,6 +46,10 @@ const config: Configuration = {
 		...baseConfig.linux,
 		...(existsSync(canaryLinuxIconPath) ? { icon: canaryLinuxIconPath } : {}),
 		synopsis: `${pkg.description} (Canary)`,
+		desktop: {
+			...baseConfig.linux?.desktop,
+			entry: { ...baseConfig.linux?.desktop?.entry, Name: displayName },
+		},
 		artifactName: `superset-canary-\${version}-\${arch}.\${ext}`,
 	},
 
