{
	"$schema": "https://biomejs.dev/schemas/2.4.2/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**",
			"!**/drizzle",
			"!**/*.template.js",
			"!**/*.template.sh",
			"!**/*.template.ts",
			"!**/plans",
			"!**/*.generated.ts",
			// Lingui catalogs: .po plus compiled messages.ts (lingui compile output).
			"!packages/i18n/locales",
			"!apps/mobile/uniwind-types.d.ts",
			"!packages/sdk/src",
			// Vendored Vale style packages (synced by `vale sync`); don't reformat.
			"!apps/marketing/vale-styles"
		]
	},
	"formatter": {
		"formatWithErrors": true
	},
	"css": {
		"parser": {
			"cssModules": true,
			"tailwindDirectives": true
		}
	},
	"linter": {
		"rules": {
			"recommended": true,
			"style": {
				// Sync subprocesses block the serving event loop (Electron main,
				// host-service, pty-daemon). Companion to the per-package
				// no-*-blocking ratchet tests, which also catch namespace access
				// (childProcess.execSync) and allowlist the legacy call sites.
				"noRestrictedImports": {
					"level": "error",
					"options": {
						"paths": {
							"node:child_process": {
								"importNames": ["execSync", "spawnSync", "execFileSync"],
								"message": "Sync subprocesses freeze the serving event loop (Electron main / host-service / pty-daemon) until the child exits — every request queues behind them. Prefer async spawn/execFile: the caller awaits the same result, but the loop keeps serving while the child runs. Git reads belong in the worker pools."
							},
							"child_process": {
								"importNames": ["execSync", "spawnSync", "execFileSync"],
								"message": "Sync subprocesses freeze the serving event loop (Electron main / host-service / pty-daemon) until the child exits — every request queues behind them. Prefer async spawn/execFile: the caller awaits the same result, but the loop keeps serving while the child runs. Git reads belong in the worker pools."
							}
						}
					}
				}
			}
		}
	},
	"overrides": [
		{
			"includes": ["packages/cli-framework/**", "packages/cli/**"],
			"linter": {
				"rules": {
					"suspicious": {
						"noExplicitAny": "off"
					},
					"style": {
						"noNonNullAssertion": "off"
					}
				}
			}
		},
		{
			// Tests, scripts, and build tooling don't run on a serving loop.
			"includes": [
				"**/*.test.ts",
				"**/*.test.tsx",
				"**/*.node-test.ts",
				"**/*.bench.ts",
				"**/test/**",
				"**/test-helpers.ts",
				"**/scripts/**"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": "off"
					}
				}
			}
		},
		{
			// Legacy on-loop sync-subprocess call sites, frozen by the
			// no-*-blocking ratchet tests — delete entries here as they're fixed.
			"includes": [
				"apps/desktop/src/main/lib/terminal-host/client.ts",
				"packages/provider-auth/src/server/auth/anthropic/anthropic.ts",
				"packages/host-service/src/providers/model-providers/LocalModelProvider/utils/resolveAnthropicCredential.ts",
				"packages/pty-daemon/src/process-tree.ts",
				"packages/shared/src/host-info.ts"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": "off"
					}
				}
			}
		},
		{
			"includes": ["apps/desktop/src/renderer/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"@superset/workspace-fs/host": "Renderer code must stay browser-compatible. Import Node filesystem helpers from the desktop server/host layer instead.",
									"@superset/workspace-fs/server": "Renderer code must stay browser-compatible. Import Node filesystem helpers from the desktop server/host layer instead.",
									"@tanstack/react-router": {
										"importNames": ["Navigate"],
										"message": "<Navigate> re-navigates whenever its props object identity changes — inline usage loops into React error #185 (#5729, SUPER-1814). Use Redirect from renderer/components/Redirect, or `beforeLoad: () => { throw redirect(...) }` for static targets."
									}
								},
								"patterns": [
									{
										"group": ["node:*"],
										"message": "Renderer code must not import Node builtins."
									}
								]
							}
						}
					}
				}
			}
		}
	]
}
